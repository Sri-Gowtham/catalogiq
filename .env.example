# Copy to .env and fill in. Never commit .env.

# Required in production: a long random string used to sign sign-in cookies.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
CATALOGIQ_JWT_SECRET=

# Set to 1 when the site is served over https (the sign-in cookie is then marked Secure).
# Leave it off only for local http, otherwise browsers will not keep the cookie.
CATALOGIQ_COOKIE_SECURE=1

# The public address(es) of the site, comma separated. Only needed when the web app is served from a different
# origin than the API; leave the default when the container serves both.
# CATALOGIQ_ALLOWED_ORIGINS=https://catalog.example.com

# Demo logins use a published password. They are OFF in production unless you turn them on.
# CATALOGIQ_ENABLE_DEMO=1

# Local demos only: show the password-reset link on screen instead of only in the server log. Never in production.
# CATALOGIQ_DEV_RESET_LINKS=1
